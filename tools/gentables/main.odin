/*
Gentables regenerates `tables.odin` from the Unicode Character Database.

Download these files from https://www.unicode.org/Public/<version>/ucd/ into one
directory:

- EastAsianWidth.txt
- extracted/DerivedGeneralCategory.txt (saved as DerivedGeneralCategory.txt)
- emoji/emoji-data.txt (saved as emoji-data.txt)

Then run, from the repository root:

	odin run tools/gentables -- <ucd-dir> <unicode-version> > tables.odin
*/
package main

import "core:fmt"
import "core:os"
import "core:slice"
import "core:strconv"
import "core:strings"

Range :: struct {
	lo, hi: rune,
}

main :: proc() {
	if len(os.args) != 3 {
		fmt.eprintln("usage: gentables <ucd-dir> <unicode-version>")
		os.exit(2)
	}
	dir := os.args[1]
	version := os.args[2]

	eaw := read_ucd(dir, "EastAsianWidth.txt")
	gc := read_ucd(dir, "DerivedGeneralCategory.txt")
	emoji := read_ucd(dir, "emoji-data.txt")

	wide: [dynamic]Range
	collect(eaw, {"W", "F"}, &wide, include_missing = true)

	zero: [dynamic]Range
	collect(gc, {"Mn", "Me", "Cf"}, &zero)
	// Hangul medial vowels and final consonants combine with the leading jamo.
	append(&zero, Range{0x1160, 0x11FF}, Range{0xD7B0, 0xD7FF})
	zero_ranges := normalize(zero[:])
	// Visible format characters keep a column: the soft hyphen and the
	// prepended concatenation marks such as the Arabic number sign.
	visible := normalize([]Range {
		{0x00AD, 0x00AD},
		{0x0600, 0x0605},
		{0x06DD, 0x06DD},
		{0x070F, 0x070F},
		{0x0890, 0x0891},
		{0x08E2, 0x08E2},
		{0x110BD, 0x110BD},
		{0x110CD, 0x110CD},
	})
	zero_ranges = subtract(zero_ranges, visible)

	emoji_prop: [dynamic]Range
	collect(emoji, {"Emoji"}, &emoji_prop)
	pictographic: [dynamic]Range
	collect(emoji, {"Extended_Pictographic"}, &pictographic)

	fmt.println("// Code generated by tools/gentables; DO NOT EDIT.")
	fmt.printfln("// Source: Unicode Character Database %s.", version)
	fmt.println()
	fmt.println("package textwidth")
	fmt.println()
	fmt.printfln("// UNICODE_VERSION is the Unicode Character Database release the width tables come from.")
	fmt.printfln("UNICODE_VERSION :: %q", version)
	emit("wide_table", "Code points with East_Asian_Width W or F; they take two columns.", normalize(wide[:]))
	emit("zero_width_table", "Nonspacing, enclosing and format code points; they take no column.", zero_ranges)
	emit("emoji_table", "Code points with the Emoji property; U+FE0F turns them into two-column emoji.", normalize(emoji_prop[:]))
	emit("pictographic_table", "Code points with Extended_Pictographic; a ZWJ joins two of them into one grapheme.", normalize(pictographic[:]))
}

read_ucd :: proc(dir, name: string) -> string {
	path := strings.concatenate({dir, "/", name})
	data, err := os.read_entire_file(path, context.allocator)
	if err != nil {
		fmt.eprintfln("gentables: cannot read %s: %v", path, err)
		os.exit(1)
	}
	return string(data)
}

// collect appends every range whose property value is one of `values`.
collect :: proc(data: string, values: []string, out: ^[dynamic]Range, include_missing := false) {
	text := data
	for raw in strings.split_lines_iterator(&text) {
		line := raw
		if include_missing && strings.has_prefix(line, "# @missing:") {
			line = line[len("# @missing:"):]
		} else if i := strings.index_byte(line, '#'); i >= 0 {
			line = line[:i]
		}
		semi := strings.index_byte(line, ';')
		if semi < 0 {
			continue
		}
		cps := strings.trim_space(line[:semi])
		value := strings.trim_space(line[semi + 1:])
		if !slice.contains(values, value) {
			continue
		}
		r, ok := parse_range(cps)
		if !ok {
			fmt.eprintfln("gentables: bad range %q", cps)
			os.exit(1)
		}
		// The catch-all @missing line covers every code point; skip it.
		if r.lo == 0 && r.hi == 0x10FFFF {
			continue
		}
		append(out, r)
	}
}

parse_range :: proc(s: string) -> (r: Range, ok: bool) {
	lo_s, hi_s := s, s
	if i := strings.index(s, ".."); i >= 0 {
		lo_s, hi_s = s[:i], s[i + 2:]
	}
	lo := strconv.parse_uint(lo_s, 16) or_return
	hi := strconv.parse_uint(hi_s, 16) or_return
	return Range{rune(lo), rune(hi)}, true
}

// normalize sorts ranges and merges the ones that overlap or touch.
normalize :: proc(ranges: []Range) -> []Range {
	sorted := slice.clone(ranges)
	slice.sort_by(sorted, proc(a, b: Range) -> bool {return a.lo < b.lo})
	out: [dynamic]Range
	for r in sorted {
		if n := len(out); n > 0 && r.lo <= out[n - 1].hi + 1 {
			out[n - 1].hi = max(out[n - 1].hi, r.hi)
		} else {
			append(&out, r)
		}
	}
	return out[:]
}

// subtract removes every code point in `holes` from `ranges`. Both are normalized.
subtract :: proc(ranges, holes: []Range) -> []Range {
	out: [dynamic]Range
	for r in ranges {
		lo := r.lo
		for h in holes {
			if h.hi < lo || h.lo > r.hi {
				continue
			}
			if h.lo > lo {
				append(&out, Range{lo, h.lo - 1})
			}
			lo = h.hi + 1
		}
		if lo <= r.hi {
			append(&out, Range{lo, r.hi})
		}
	}
	return out[:]
}

emit :: proc(name, doc: string, ranges: []Range) {
	fmt.println()
	fmt.printfln("// %s: %s", name, doc)
	fmt.println("@(private, rodata)")
	fmt.printfln("%s := [%d]Range{{", name, len(ranges))
	for r in ranges {
		fmt.printfln("\t{{0x%04X, 0x%04X}},", r.lo, r.hi)
	}
	fmt.println("}")
}
